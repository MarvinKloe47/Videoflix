# Required: replace both placeholders with different, long random values.
# Use a password manager; no local Python installation is needed.
# Django: DEBUG=true is for local HTTP only. HTTPS deployment needs DEBUG=false.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: choose a password. Keep HOST/PORT for the Compose network.
DB_NAME=videoflix
DB_USER=videoflix
DB_PASSWORD=replace-with-a-long-random-database-password
DB_HOST=db
DB_PORT=5432

# Optional automatic admin: set BOTH values to create a known administrator.
# Leave both empty to skip. Existing accounts/passwords are never overwritten.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Redis: queue uses database 0; metadata cache uses database 1.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_LOCATION=redis://redis:6379/1

# Email: console output works locally without SMTP credentials.
# For real delivery, use django.core.mail.backends.smtp.EmailBackend and fill
# EMAIL_HOST, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD and DEFAULT_FROM_EMAIL.
# Enable TLS OR SSL, never both. SSL usually uses port 465 instead of 587.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@videoflix.local

# Frontend: change these URLs if the separate frontend runs elsewhere.
# Use the same hostname for frontend/backend (localhost OR 127.0.0.1).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_ACTIVATION_URL=http://127.0.0.1:5500/pages/auth/activate.html
FRONTEND_PASSWORD_RESET_URL=http://127.0.0.1:5500/pages/auth/confirm_password.html

# Optional host port; the backend is only published on this computer.
HTTP_PORT=8000

# JWT lifetime in core/settings.py: access 5 min, refresh 1 day.
# Cookies keep HttpOnly and SameSite=Lax; Secure is enabled when DEBUG=false.
# FFmpeg/FFprobe are installed in the image; no host setup is required.
