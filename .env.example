# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
# true for local HTTP development; false for HTTPS deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=videoflix
DB_USER=videoflix
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_URL=redis://localhost:6379/1
VIDEO_ENQUEUE_HLS_JOBS=true
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_ACTIVATION_URL=http://127.0.0.1:5500/pages/auth/activate.html
FRONTEND_PASSWORD_RESET_URL=http://127.0.0.1:5500/pages/auth/confirm_password.html
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@videoflix.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
